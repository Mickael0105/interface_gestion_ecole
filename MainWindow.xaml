<Window x:Class="MyApp.Interface.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connexion - Apli Micka" Height="720" Width="1120" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#FF0F172A">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    
    <Grid>
        <!-- Background Image with Blur Effect -->
        <Grid.Background>
            <ImageBrush ImageSource="/pngtree-abstract-background-technology-of-data-applications-image_555017.jpg" Stretch="UniformToFill" Opacity="0.3"/>
        </Grid.Background>
        
        <!-- Gradient Overlay -->
        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" Opacity="0.85">
                    <GradientStop Color="#0F172A" Offset="0"/>
                    <GradientStop Color="#1E293B" Offset="0.5"/>
                    <GradientStop Color="#334155" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
        </Grid>

        <!-- Animated Accent Gradient Overlay -->
        <Border>
            <Border.Background>
                <RadialGradientBrush>
                    <GradientStop Color="#206366F1" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Main Login Card with 4D Effect -->
        <Border Width="700" Height="540" CornerRadius="24" Background="{DynamicResource PageBackground}" Padding="40" 
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Resources>
                <Style x:Key="InputStyle" TargetType="Control">
                    <Setter Property="Margin" Value="0,8,0,8"/>
                    <Setter Property="FontSize" Value="15"/>
                </Style>
                <Style TargetType="Button" x:Key="PrimaryButton">
                    <Setter Property="Height" Value="48"/>
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#6366F1" Offset="0"/>
                                <GradientStop Color="#8B5CF6" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Color="#406366F1" Opacity="0.5"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#7C3AED" Offset="0"/>
                                                    <GradientStop Color="#A855F7" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Border.Resources>

            <Border.Effect>
                <DropShadowEffect x:Name="GlowEffect" BlurRadius="40" ShadowDepth="0" Color="#6366F1" Opacity="0.6"/>
            </Border.Effect>
            
            <Border.Triggers>
                <EventTrigger RoutedEvent="Border.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="GlowEffect" Storyboard.TargetProperty="BlurRadius" From="30" To="50" Duration="0:0:3"/>
                            <ColorAnimation Storyboard.TargetName="GlowEffect" Storyboard.TargetProperty="Color" From="#6366F1" To="#8B5CF6" Duration="0:0:3"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.8*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <!-- Left panel: logo and branding -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Border Width="130" Height="130" CornerRadius="65" Margin="0,0,0,20">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#6366F1" Offset="0"/>
                                <GradientStop Color="#8B5CF6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="8" Color="#406366F1" Opacity="0.4"/>
                        </Border.Effect>
                        
                        <Image x:Name="imgLogo" Width="115" Height="115" Stretch="UniformToFill" 
                       Source="/pngtree-logo-design-for-school-and-science-education-png-image_8968150.png">
                            <Image.Clip>
                                <EllipseGeometry Center="57.5,57.5" RadiusX="57.5" RadiusY="57.5"/>
                            </Image.Clip>
                        </Image>
                    </Border>

                    <TextBlock Text="App Micka" FontSize="28" FontWeight="Black" Margin="0,0,0,10" 
                               HorizontalAlignment="Center" FontFamily="Poppins" Foreground="{DynamicResource TextDarkBrush}"/>
                    <TextBlock Text="Système de Gestion" Foreground="{DynamicResource TextLightBrush}" TextWrapping="Wrap" 
                               HorizontalAlignment="Center" TextAlignment="Center" FontFamily="Poppins" 
                               FontSize="13" FontWeight="Medium" Margin="0,0,0,2"/>
                    <TextBlock Text="Scolaire" Foreground="{DynamicResource TextLightBrush}" TextWrapping="Wrap" 
                               HorizontalAlignment="Center" TextAlignment="Center" FontFamily="Poppins" 
                               FontSize="13" FontWeight="Medium"/>
                    
                    <!-- Decorative Element -->
                    <Border Height="3" Width="70" Background="{StaticResource VibrantGradient}" 
                            CornerRadius="2" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Right panel: form -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="Bienvenue !" FontSize="30" FontWeight="Black" Margin="0,0,0,6" 
                               FontFamily="Poppins" Foreground="{DynamicResource TextDarkBrush}"/>
                    <TextBlock Text="Connectez-vous pour accéder" Foreground="{DynamicResource TextLightBrush}" 
                               FontSize="13" Margin="0,0,0,20" FontWeight="Medium" FontFamily="Poppins"/>

                    <TextBlock Text="Nom d'utilisateur" FontSize="12" Foreground="{DynamicResource TextLightBrush}" 
                               FontFamily="Poppins" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Border CornerRadius="10" Background="{DynamicResource PageBackground}" BorderBrush="#E2E8F0" BorderThickness="2" Margin="0,0,0,14">
                        <TextBox x:Name="txtUsername" Style="{StaticResource InputStyle}" Height="42" 
                                 Padding="12,10" BorderThickness="0" Background="Transparent" FontSize="14"/>
                    </Border>

                    <TextBlock Text="Mot de passe" FontSize="12" Foreground="#334155" Margin="0,0,0,6" 
                               FontFamily="Segoe UI" FontWeight="SemiBold"/>
                    
                    <Border CornerRadius="10" Background="{DynamicResource PageBackground}" BorderBrush="#E2E8F0" BorderThickness="2">
                        <Grid>
                            <!-- Password Box (Default) -->
                            <PasswordBox x:Name="pwdPassword" Style="{StaticResource InputStyle}" Height="42" 
                                         Padding="12,10" BorderThickness="0" Background="Transparent" 
                                         PasswordChanged="PwdPassword_PasswordChanged"/>
                            
                            <!-- Visible Text Box (For "Show Password") -->
                            <TextBox x:Name="txtVisiblePassword" Style="{StaticResource InputStyle}" Height="42" 
                                     Padding="12,10" BorderThickness="0" Background="Transparent" 
                                     Visibility="Collapsed" TextChanged="TxtVisiblePassword_TextChanged"/>
                            
                            <!-- Toggle Button (Eye) -->
                            <Button x:Name="btnTogglePassword" Width="30" Height="30" HorizontalAlignment="Right" 
                                    VerticalAlignment="Center" Margin="0,0,6,0" Background="Transparent" 
                                    BorderThickness="0" Click="BtnTogglePassword_Click" Cursor="Hand">
                                <TextBlock Text="👁" FontSize="16" Foreground="#64748B"/>
                            </Button>
                        </Grid>
                    </Border>

                    <Button Content="Mot de passe oublié ?" Click="BtnForgotPassword_Click" 
                            HorizontalAlignment="Right" Margin="0,6,0,0" Background="Transparent" 
                            BorderThickness="0" Foreground="#6366F1" FontSize="12" Cursor="Hand" 
                            FontWeight="SemiBold"/>

                    <TextBlock x:Name="txtMessage" Foreground="#EF4444" Margin="0,10,0,0" 
                               TextWrapping="Wrap" FontSize="12" FontWeight="Medium"/>

                    <Button x:Name="btnLogin" Content="Se connecter" Style="{StaticResource PrimaryButton}" 
                            Click="BtnLogin_Click" Margin="0,16,0,0" IsDefault="True" 
                            FontFamily="Poppins"/>
                    
                    <Button x:Name="btnQuit" Content="Fermer" Click="BtnQuit_Click" 
                            Style="{StaticResource ModernDangerButton}" Height="42" Margin="0,10,0,0" 
                            FontFamily="Poppins" FontSize="13"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Decorative Floating Elements -->
        <Ellipse Width="200" Height="200" HorizontalAlignment="Left" VerticalAlignment="Top" 
                 Margin="-100,-100,0,0" Opacity="0.1">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#6366F1" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        
        <Ellipse Width="300" Height="300" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                 Margin="0,0,-150,-150" Opacity="0.1">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#8B5CF6" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
    </Grid>
</Window>
